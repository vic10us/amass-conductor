<div>
    <RadzenProgressBar Value="@Percent" ShowValue="true" Style="height: 20px;" />
    <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-1">
        @Completed / @Total work items
    </RadzenText>
</div>

@code {
    [Parameter] public int Completed { get; set; }
    [Parameter] public int Total { get; set; }

    private double Percent => Total > 0 ? Math.Round(100.0 * Completed / Total, 1) : 0;
}
