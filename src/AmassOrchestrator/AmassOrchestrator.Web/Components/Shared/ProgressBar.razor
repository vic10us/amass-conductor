<div>
    <RadzenProgressBar Value="@Percent" ShowValue="true" Style="@BarStyle" />
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mt-1">
        <RadzenText TextStyle="TextStyle.Caption">
            @Completed / @Total work items
            @if (ItemsPerSecond > 0 && !IsCompleted)
            {
                <text>(@ItemsPerSecond.ToString("F2") items/s)</text>
            }
        </RadzenText>
        @if (IsFailed)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
        }
        else if (IsCancelled)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Cancelled" />
        }
        else if (IsCompleted)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Completed" />
        }
    </RadzenStack>
</div>

@code {
    [Parameter] public int Completed { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public bool IsCompleted { get; set; }
    [Parameter] public bool IsFailed { get; set; }
    [Parameter] public bool IsCancelled { get; set; }
    [Parameter] public double ItemsPerSecond { get; set; }

    private double Percent => Total > 0 ? Math.Round(100.0 * Completed / Total, 1) : 0;

    private string BarStyle
    {
        get
        {
            if (IsFailed)
                return "height: 20px; --rz-progressbar-fill-background: var(--rz-danger);";
            if (IsCancelled)
                return "height: 20px; --rz-progressbar-fill-background: var(--rz-warning);";
            if (IsCompleted)
                return "height: 20px; --rz-progressbar-fill-background: var(--rz-success);";
            return "height: 20px;";
        }
    }
}
