@inject NavigationManager Navigation

<RadzenCard Style="cursor: pointer;" @onclick="NavigateToDetail">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
        <RadzenStack Gap="0.25rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@State.Pod.PodName</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">
                Private IP: @State.Pod.PodIP
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">
                @if (State.AnnotationInfo?.PublicIP is not null)
                {
                    @: Public IP: @State.AnnotationInfo.PublicIP
                }
            </RadzenText>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.End" Gap="0.25rem">
            <PodPhaseBadge PodPhase="@State.Pod.PodPhase()" />
            <HealthBadge IsHealthy="@State.IsHealthy" IsReady="@State.Pod.IsReady" />
            @if (State.AnnotationInfo is not null)
            {
                @if (State.AnnotationInfo.CheckStatus == IpCheckStatus.Error)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Tor ?" />
                }
                else if (State.AnnotationInfo.IsTor == true)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Tor" />
                }
                else if (State.AnnotationInfo.IsTor == false)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Direct" />
                }
            }
        </RadzenStack>
    </RadzenStack>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">
        @State.Sessions.Count session(s) active
    </RadzenText>
    @if (State.Sessions.Count > 0)
    {
        var totalCompleted = State.Sessions.Sum(s => s.WorkItemsCompleted);
        var totalItems = State.Sessions.Sum(s => s.WorkItemsTotal);
        var totalRate = State.Sessions.Sum(s => s.ItemsPerSecond);
        <ProgressBar Completed="@totalCompleted" Total="@totalItems" ItemsPerSecond="@totalRate" />
    }
</RadzenCard>

@code {
    [Parameter, EditorRequired] public EngineInstanceState State { get; set; } = default!;

    private void NavigateToDetail()
    {
        Navigation.NavigateTo($"engine/{Uri.EscapeDataString(State.Pod.PodName)}");
    }
}
