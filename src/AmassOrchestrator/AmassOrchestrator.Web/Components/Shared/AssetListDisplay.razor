@using Radzen

<div>
    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">@Label</RadzenText>
    @if (Items is { Count: > 0 } items)
    {
        @if (items.Count > Threshold)
        {
            <RadzenText TextStyle="TextStyle.Body2">
                @($"{items.Count:N0} items")
            </RadzenText>
        }
        else
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                @foreach (var item in items)
                {
                    <RadzenBadge Text="@item" BadgeStyle="@BadgeStyle" />
                }
            </RadzenStack>
        }
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">None</RadzenText>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public List<string>? Items { get; set; }
    [Parameter] public BadgeStyle BadgeStyle { get; set; } = BadgeStyle.Primary;
    [Parameter] public int Threshold { get; set; } = 100;
}
