@using AmassOrchestrator.Web.Configuration
@using AmassOrchestrator.Web.Models
@using AmassOrchestrator.Web.Services
@using Microsoft.Extensions.Options
@inject DialogService DialogService
@inject DefaultsLoaderService DefaultsLoader
@inject IOptions<OrchestratorOptions> OrchestratorOptions

<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Scope">
            <RadzenStack Gap="1rem" class="rz-p-2">
                <RadzenFormField Text="Domains (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_domains" Rows="4" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="ASNs (comma or newline separated, e.g. 13335)">
                    <RadzenTextArea @bind-Value="@_asns" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="CIDRs (comma or newline separated, e.g. 192.0.2.0/24)">
                    <RadzenTextArea @bind-Value="@_cidrs" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="IPs (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_ips" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Ports (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_ports" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Blacklist (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_blacklist" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Assets">
            <RadzenStack Gap="1rem" class="rz-p-2">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenCheckBox @bind-Value="@_submitDomainsAsFqdnAssets" Name="submitDomainsAsFqdnAssets" />
                    <RadzenLabel Text="Also submit scope domains as FQDN assets" Component="submitDomainsAsFqdnAssets" />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption">
                    When checked, scope domains are automatically added as FQDN seed assets for enumeration.
                </RadzenText>
                <RadzenFormField Text="FQDNs (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_assetFqdns" Rows="3" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="IP Addresses (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_assetIpAddresses" Rows="3" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="ASNs (comma or newline separated, e.g. 13335)">
                    <RadzenTextArea @bind-Value="@_assetAsns" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Netblocks (comma or newline separated, e.g. 192.0.2.0/24)">
                    <RadzenTextArea @bind-Value="@_assetNetblocks" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Organizations (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_assetOrganizations" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenFormField Text="Locations (comma or newline separated)">
                    <RadzenTextArea @bind-Value="@_assetLocations" Rows="2" Style="width: 100%;" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Options">
            <RadzenStack Gap="1rem" class="rz-p-2">
                <RadzenCheckBox @bind-Value="@_active" Name="active" />
                <RadzenLabel Text="Active — enable active DNS techniques" Component="active" />

                <RadzenCheckBox @bind-Value="@_bruteForce" Name="bruteForce" />
                <RadzenLabel Text="Brute Force — enable subdomain brute forcing" Component="bruteForce" />

                <RadzenCheckBox @bind-Value="@_alterations" Name="alterations" />
                <RadzenLabel Text="Alterations — enable name alterations/permutations" Component="alterations" />

                <RadzenCheckBox @bind-Value="@_rigidBoundaries" Name="rigidBoundaries" />
                <RadzenLabel Text="Rigid Boundaries — strict scope enforcement" Component="rigidBoundaries" />
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Wordlists">
            <RadzenStack Gap="1rem" class="rz-p-2">
                <RadzenFormField Text="Brute Force Wordlist (one per line)">
                    <RadzenTextArea @bind-Value="@_bruteForceWordlist" Rows="8" Style="width: 100%; font-family: monospace; font-size: 12px;" />
                </RadzenFormField>
                <RadzenFormField Text="Alterations Wordlist (one per line)">
                    <RadzenTextArea @bind-Value="@_alterationsWordlist" Rows="8" Style="width: 100%; font-family: monospace; font-size: 12px;" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Database">
            <RadzenStack Gap="1rem" class="rz-p-2">
                <RadzenFormField Text="Database Connection URL">
                    <RadzenTextBox Value="@_databaseUrl" ValueChanged="@OnDatabaseUrlChanged" Placeholder="postgres://user:pass@host:5432/dbname" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption">
                    Paste a full URL to auto-populate the fields below, or fill them in manually.
                </RadzenText>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Database System" Style="width: 100%;">
                            <RadzenDropDown TValue="string" @bind-Value="@_dbSystem" Data="@_supportedDbSystems" AllowClear="false" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-pt-4">
                            <RadzenCheckBox @bind-Value="@_dbPrimary" Name="dbPrimary" />
                            <RadzenLabel Text="Primary database" Component="dbPrimary" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="8">
                        <RadzenFormField Text="Host" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="@_dbHost" Placeholder="localhost" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="Port" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="@_dbPort" Placeholder="5432" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenFormField Text="Database Name" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@_dbName" Placeholder="amass" Style="width: 100%;" />
                </RadzenFormField>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Username" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="@_dbUsername" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenFormField Text="Password" Style="width: 100%;">
                            <RadzenPassword @bind-Value="@_dbPassword" Style="width: 100%;" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenFormField Text="Options" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="@_dbOptions" Placeholder="sslmode=disable" Style="width: 100%;" />
                </RadzenFormField>
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Datasources">
            <RadzenStack Gap="1rem" class="rz-p-2">
                <RadzenFormField Text="Datasources Configuration (YAML)">
                    <RadzenTextArea @bind-Value="@_datasourcesYaml" Rows="12" Style="width: 100%; font-family: monospace; font-size: 12px;" />
                </RadzenFormField>
                <RadzenText TextStyle="TextStyle.Caption">
                    Paste YAML in the Amass datasources format. See docs/example/datasources.yaml for reference.
                </RadzenText>
                @if (!string.IsNullOrEmpty(_datasourceError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Size="AlertSize.Small">
                        @_datasourceError
                    </RadzenAlert>
                }
            </RadzenStack>
        </RadzenTabsItem>

        <RadzenTabsItem Text="Transformations">
            <RadzenStack Gap="0.5rem" class="rz-p-2">
                <RadzenText TextStyle="TextStyle.Caption">
                    Configure asset transformations. Disable rows to exclude them from the session config.
                </RadzenText>
                <div style="max-height: 400px; overflow-y: auto;">
                    <RadzenDataGrid TItem="TransformationRow" Data="@_transformations" AllowSorting="false" Style="font-size: 13px;">
                        <Columns>
                            <RadzenDataGridColumn TItem="TransformationRow" Title="" Width="40px" Sortable="false">
                                <Template Context="row">
                                    <RadzenCheckBox @bind-Value="@row.Enabled" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TransformationRow" Title="Transformation" Width="200px" Sortable="false">
                                <Template Context="row">
                                    <RadzenText Text="@row.Key" Style="font-family: monospace; font-size: 12px;" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TransformationRow" Title="Priority" Width="100px" Sortable="false">
                                <Template Context="row">
                                    <RadzenNumeric @bind-Value="@row.Priority" Min="0" Max="100" Style="width: 80px;" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TransformationRow" Title="Confidence" Width="110px" Sortable="false">
                                <Template Context="row">
                                    <RadzenNumeric @bind-Value="@row.Confidence" Min="0" Max="100" Style="width: 80px;" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="TransformationRow" Title="TTL (min)" Width="110px" Sortable="false">
                                <Template Context="row">
                                    <RadzenNumeric @bind-Value="@row.Ttl" Min="0" Style="width: 90px;" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem" class="rz-mt-2">
                    <RadzenFormField Text="Custom Transformation Key" Style="flex: 1;">
                        <RadzenTextBox @bind-Value="@_customTransformationKey" Placeholder="FromType->ToType" Style="width: 100%;" />
                    </RadzenFormField>
                    <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Secondary" Click="@OnAddCustomTransformation" Size="ButtonSize.Small" />
                </RadzenStack>
            </RadzenStack>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@if (ShowEngineChoice && !string.IsNullOrEmpty(OriginalEnginePodName))
{
    <RadzenStack Gap="0.5rem" class="rz-mt-2 rz-p-2" Style="border: 1px solid var(--rz-border-color); border-radius: var(--rz-border-radius);">
        <RadzenText TextStyle="TextStyle.Subtitle2">Engine Selection</RadzenText>
        <RadzenRadioButtonList @bind-Value="@_useSameEngine" TValue="bool" Orientation="Orientation.Vertical">
            <Items>
                <RadzenRadioButtonListItem Text="Auto-select best engine" Value="false" />
                <RadzenRadioButtonListItem Text="@($"Same engine: {OriginalEnginePodName}")" Value="true" />
            </Items>
        </RadzenRadioButtonList>
    </RadzenStack>
}

@if (!string.IsNullOrEmpty(_validationError))
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Lighter" Size="AlertSize.Small" class="rz-mt-2">
        @_validationError
    </RadzenAlert>
}

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-4">
    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(null))" />
    <RadzenButton Text="@(InitialConfig != null ? "Restart" : "Create")" ButtonStyle="ButtonStyle.Primary" Click="@OnCreate" />
</RadzenStack>

@code {
    [Parameter] public AmassConfig? InitialConfig { get; set; }
    [Parameter] public string? OriginalEnginePodName { get; set; }
    [Parameter] public bool ShowEngineChoice { get; set; }

    private string _domains = string.Empty;
    private string _asns = string.Empty;
    private string _cidrs = string.Empty;
    private string _ips = string.Empty;
    private string _ports = "80, 443, 8000, 8080, 8443, 8888";
    private string _blacklist = string.Empty;
    private bool _active;
    private bool _bruteForce;
    private bool _alterations;
    private bool _rigidBoundaries;
    private string _bruteForceWordlist = string.Empty;
    private string _alterationsWordlist = string.Empty;
    private string _databaseUrl = string.Empty;
    private string _dbSystem = "postgres";
    private bool _dbPrimary = true;
    private string _dbHost = string.Empty;
    private string _dbPort = string.Empty;
    private string _dbName = string.Empty;
    private string _dbUsername = string.Empty;
    private string _dbPassword = string.Empty;
    private string _dbOptions = string.Empty;
    private string _datasourcesYaml = string.Empty;
    private string? _validationError;
    private string? _datasourceError;
    private string _customTransformationKey = string.Empty;
    private List<TransformationRow> _transformations = [];
    private List<string> _supportedDbSystems = [];
    private bool _useSameEngine;
    private bool _submitDomainsAsFqdnAssets = true;
    private string _assetFqdns = string.Empty;
    private string _assetIpAddresses = string.Empty;
    private string _assetAsns = string.Empty;
    private string _assetNetblocks = string.Empty;
    private string _assetOrganizations = string.Empty;
    private string _assetLocations = string.Empty;

    protected override void OnInitialized()
    {
        _bruteForceWordlist = DefaultsLoader.GetBruteForceWordlist();
        _alterationsWordlist = DefaultsLoader.GetAlterationsWordlist();
        _transformations = DefaultsLoader.GetDefaultTransformations();
        _supportedDbSystems = OrchestratorOptions.Value.SupportedDatabaseSystems.Distinct().ToList();

        if (InitialConfig != null)
            PopulateFromConfig(InitialConfig);
    }

    private void PopulateFromConfig(AmassConfig config)
    {
        _domains = config.Scope?.Domains != null ? string.Join("\n", config.Scope.Domains) : string.Empty;
        _asns = config.Scope?.Asns != null ? string.Join("\n", config.Scope.Asns) : string.Empty;
        _cidrs = config.Scope?.Cidrs != null
            ? string.Join("\n", config.Scope.Cidrs.Select(FormatCidr))
            : string.Empty;
        _ips = config.Scope?.Ips != null
            ? string.Join("\n", config.Scope.Ips.Select(b => new System.Net.IPAddress(b).ToString()))
            : string.Empty;
        _ports = config.Scope?.Ports != null ? string.Join(", ", config.Scope.Ports) : "80, 443, 8000, 8080, 8443, 8888";
        _blacklist = config.Scope?.Blacklist != null ? string.Join("\n", config.Scope.Blacklist) : string.Empty;
        _active = config.Active == true;
        _bruteForce = config.BruteForce == true;
        _alterations = config.Alterations == true;
        _rigidBoundaries = config.RigidBoundaries == true;

        if (config.Wordlist is { Count: > 0 })
            _bruteForceWordlist = string.Join("\n", config.Wordlist);
        if (config.AltWorldlist is { Count: > 0 })
            _alterationsWordlist = string.Join("\n", config.AltWorldlist);

        var db = config.Database?.FirstOrDefault();
        if (db != null)
        {
            _dbSystem = db.System ?? "postgres";
            _dbPrimary = db.Primary ?? true;
            _databaseUrl = db.Url ?? string.Empty;
            _dbHost = db.Host ?? string.Empty;
            _dbPort = db.Port ?? string.Empty;
            _dbName = db.DbName ?? string.Empty;
            _dbUsername = db.Username ?? string.Empty;
            _dbPassword = db.Password ?? string.Empty;
            _dbOptions = db.Options ?? string.Empty;
        }

        _datasourcesYaml = DatasourceConfigParser.Serialize(config.DatasourceConfig) ?? string.Empty;

        if (config.Transformations is { Count: > 0 })
        {
            foreach (var row in _transformations)
            {
                if (config.Transformations.TryGetValue(row.Key, out var t))
                {
                    row.Enabled = true;
                    row.Priority = t.Priority ?? row.Priority;
                    row.Confidence = t.Confidence ?? row.Confidence;
                    row.Ttl = t.Ttl ?? row.Ttl;
                }
                else
                {
                    row.Enabled = false;
                }
            }

            // Add any custom transformations not in defaults
            foreach (var kvp in config.Transformations)
            {
                if (!_transformations.Any(t => t.Key == kvp.Key))
                {
                    _transformations.Add(new TransformationRow
                    {
                        Enabled = true,
                        Key = kvp.Key,
                        Priority = kvp.Value.Priority ?? 5,
                        Confidence = kvp.Value.Confidence ?? 50,
                        Ttl = kvp.Value.Ttl ?? 1440
                    });
                }
            }
        }
    }

    private void OnAddCustomTransformation()
    {
        var key = _customTransformationKey.Trim();
        if (string.IsNullOrEmpty(key) || !key.Contains("->"))
            return;
        if (_transformations.Any(t => t.Key == key))
            return;
        _transformations.Add(new TransformationRow { Enabled = true, Key = key, Priority = 5, Confidence = 50, Ttl = 1440 });
        _customTransformationKey = string.Empty;
    }

    private void OnCreate()
    {
        _validationError = null;
        _datasourceError = null;

        var domains = ParseStringList(_domains);
        var assetObj = new SeedAssets
        {
            Fqdns = ParseStringList(_assetFqdns),
            IpAddresses = ParseStringList(_assetIpAddresses),
            AutonomousSystems = ParseIntList(_assetAsns),
            Netblocks = ParseStringList(_assetNetblocks),
            Organizations = ParseStringList(_assetOrganizations),
            Locations = ParseStringList(_assetLocations)
        };

        if (domains.Count == 0 && !assetObj.HasAny())
        {
            _validationError = "At least one domain or seed asset is required.";
            return;
        }

        DataSourceConfig? datasourceConfig = null;
        if (!string.IsNullOrWhiteSpace(_datasourcesYaml))
        {
            try
            {
                datasourceConfig = DatasourceConfigParser.Parse(_datasourcesYaml);
            }
            catch (Exception ex)
            {
                _datasourceError = $"Invalid YAML: {ex.Message}";
                return;
            }
        }

        var wordlist = ParseWordlist(_bruteForceWordlist);
        var altWordlist = ParseWordlist(_alterationsWordlist);

        var config = new AmassConfig
        {
            Scope = new AmassScope
            {
                Domains = domains.Count > 0 ? domains : null,
                Asns = ParseIntList(_asns) is { Count: > 0 } scopeAsns ? scopeAsns : null,
                Cidrs = ParseCidrList(_cidrs) is { Count: > 0 } scopeCidrs ? scopeCidrs : null,
                Ips = ParseIpList(_ips) is { Count: > 0 } scopeIps ? scopeIps : null,
                Ports = ParseIntList(_ports) is { Count: > 0 } scopePorts ? scopePorts : null,
                Blacklist = ParseStringList(_blacklist) is { Count: > 0 } bl ? bl : null
            },
            Active = _active ? true : null,
            RigidBoundaries = _rigidBoundaries ? true : null,
            BruteForce = _bruteForce ? true : null,
            Alterations = _alterations ? true : null,
            Wordlist = wordlist.Count > 0 ? wordlist : null,
            AltWorldlist = altWordlist.Count > 0 ? altWordlist : null,
            Database = HasDatabaseConfig() ? [new AmassDatabase
            {
                System = _dbSystem,
                Primary = _dbPrimary,
                Url = !string.IsNullOrWhiteSpace(_databaseUrl) ? _databaseUrl.Trim() : null,
                Host = !string.IsNullOrWhiteSpace(_dbHost) ? _dbHost.Trim() : null,
                Port = !string.IsNullOrWhiteSpace(_dbPort) ? _dbPort.Trim() : null,
                DbName = !string.IsNullOrWhiteSpace(_dbName) ? _dbName.Trim() : null,
                Username = !string.IsNullOrWhiteSpace(_dbUsername) ? _dbUsername.Trim() : null,
                Password = !string.IsNullOrWhiteSpace(_dbPassword) ? _dbPassword.Trim() : null,
                Options = !string.IsNullOrWhiteSpace(_dbOptions) ? _dbOptions.Trim() : null,
            }] : null,
            DatasourceConfig = datasourceConfig,
            Transformations = _transformations.Any(t => t.Enabled)
                ? _transformations
                    .Where(t => t.Enabled)
                    .ToDictionary(
                        t => t.Key,
                        t => new AmassTransformation
                        {
                            Priority = t.Priority,
                            Confidence = t.Confidence,
                            Ttl = t.Ttl
                        })
                : null
        };

        var dialogResult = new CreateSessionDialogResult
        {
            Config = config,
            Assets = assetObj,
            SubmitDomainsAsFqdnAssets = _submitDomainsAsFqdnAssets,
            UseSameEngine = _useSameEngine && !string.IsNullOrEmpty(OriginalEnginePodName),
            TargetEnginePodName = _useSameEngine ? OriginalEnginePodName : null
        };
        DialogService.Close(dialogResult);
    }

    private void OnDatabaseUrlChanged(string value)
    {
        _databaseUrl = value;
        ParseDatabaseUrl();
    }

    private void ParseDatabaseUrl()
    {
        if (string.IsNullOrWhiteSpace(_databaseUrl))
            return;

        try
        {
            if (Uri.TryCreate(_databaseUrl.Trim(), UriKind.Absolute, out var uri))
            {
                var supported = OrchestratorOptions.Value.SupportedDatabaseSystems;
                var scheme = uri.Scheme;
                if (supported.Contains(scheme, StringComparer.OrdinalIgnoreCase))
                {
                    _dbSystem = scheme;
                }

                _dbHost = uri.Host;
                _dbPort = uri.Port > 0 ? uri.Port.ToString() : string.Empty;
                _dbName = uri.AbsolutePath.TrimStart('/');

                if (!string.IsNullOrEmpty(uri.UserInfo))
                {
                    var parts = uri.UserInfo.Split(':', 2);
                    _dbUsername = Uri.UnescapeDataString(parts[0]);
                    _dbPassword = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : string.Empty;
                }

                _dbOptions = string.IsNullOrEmpty(uri.Query) ? string.Empty : uri.Query.TrimStart('?');
            }
        }
        catch
        {
            // Silently ignore parse errors to prevent circuit crashes
        }
    }

    private bool HasDatabaseConfig() =>
        !string.IsNullOrWhiteSpace(_databaseUrl) ||
        !string.IsNullOrWhiteSpace(_dbHost) ||
        !string.IsNullOrWhiteSpace(_dbName);

    private static List<string> ParseWordlist(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private static List<string> ParseStringList(string text) =>
        text.Split(new[] { ',', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private static List<int> ParseIntList(string text) =>
        text.Split(new[] { ',', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var v) ? v : (int?)null)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToList();

    private static List<IpNet> ParseCidrList(string text) =>
        ParseStringList(text)
            .Select(cidr =>
            {
                var parts = cidr.Split('/');
                if (parts.Length != 2 || !System.Net.IPAddress.TryParse(parts[0], out var addr) || !int.TryParse(parts[1], out var prefix))
                    return null;
                var ipBytes = addr.GetAddressBytes();
                var maskBytes = new byte[ipBytes.Length];
                for (int i = 0; i < prefix; i++)
                    maskBytes[i / 8] |= (byte)(0x80 >> (i % 8));
                return new IpNet { Ip = ipBytes, Mask = maskBytes };
            })
            .Where(n => n != null)
            .ToList()!;

    private static List<byte[]> ParseIpList(string text) =>
        ParseStringList(text)
            .Select(s => System.Net.IPAddress.TryParse(s, out var addr) ? addr.GetAddressBytes() : null)
            .Where(b => b != null)
            .ToList()!;

    private static string FormatCidr(IpNet net)
    {
        if (net.Ip == null || net.Mask == null) return string.Empty;
        var addr = new System.Net.IPAddress(net.Ip);
        int prefix = 0;
        foreach (var b in net.Mask)
        {
            for (int i = 7; i >= 0; i--)
            {
                if ((b & (1 << i)) != 0) prefix++;
                else break;
            }
        }
        return $"{addr}/{prefix}";
    }
}
