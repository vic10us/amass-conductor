@page "/logs"
@implements IDisposable
@inject LogAggregatorService LogAggregator
@inject EngineStateStore StateStore
@inject ISessionRepository SessionRepository

<PageTitle>Logs - Amass Orchestrator</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Logs</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" class="rz-mb-4" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
    <RadzenFormField Text="Engine">
        <RadzenDropDown TValue="string" Data="@_engineOptions" @bind-Value="@_engineFilter" AllowClear="true" Placeholder="All engines" Style="width: 200px;" Change="@OnFilterChanged" />
    </RadzenFormField>
    <RadzenFormField Text="Session">
        <RadzenDropDown TValue="string" Data="@_sessionOptions" @bind-Value="@_sessionFilter" AllowClear="true" Placeholder="All sessions" Style="width: 200px;" Change="@OnFilterChanged" />
    </RadzenFormField>
    <RadzenFormField Text="Search">
        <RadzenTextBox @bind-Value="@_textSearch" Placeholder="Filter logs..." Style="width: 200px;" />
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenCheckBox TValue="bool" @bind-Value="@_includeLive" Change="@OnIncludeLiveChanged" />
        <RadzenLabel Text="Include Live" />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenCheckBox TValue="bool" @bind-Value="@_autoScroll" />
        <RadzenLabel Text="Auto-scroll" />
    </RadzenStack>
    <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@LoadHistoricalLogs" />
</RadzenStack>

@if (_loading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" class="rz-mb-4" />
}

<pre style="max-height: 600px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px; font-size: 0.85rem; font-family: 'Cascadia Code', 'Fira Code', monospace;">@string.Join("\n", GetFilteredLines())</pre>

@code {
    private const int MaxLiveEntries = 1000;
    private readonly LinkedList<AggregatedLogEntry> _liveEntries = new();
    private List<LogRecord> _historicalLogs = [];
    private bool _autoScroll = true;
    private bool _includeLive;
    private bool _loading;
    private string? _engineFilter;
    private string? _sessionFilter;
    private string? _textSearch;
    private List<string> _engineOptions = [];
    private List<string> _sessionOptions = [];

    protected override async Task OnInitializedAsync()
    {
        StateStore.OnStateChanged += HandleStateChanged;
        await RefreshOptionsFromDb();
        await LoadHistoricalLogs();
    }

    private async Task RefreshOptionsFromDb()
    {
        var sessions = await SessionRepository.GetAllAsync();
        var engines = new HashSet<string>();
        var tokens = new HashSet<string>();

        foreach (var s in sessions)
        {
            if (!string.IsNullOrEmpty(s.EnginePodName))
                engines.Add(s.EnginePodName);
            if (!string.IsNullOrEmpty(s.Token))
                tokens.Add(s.Token);
        }

        // Also include live state engines/sessions
        foreach (var kvp in StateStore.States)
        {
            engines.Add(kvp.Key);
            foreach (var session in kvp.Value.Sessions)
                tokens.Add(session.Token);
        }

        _engineOptions = engines.OrderBy(e => e).ToList();
        _sessionOptions = tokens.OrderBy(t => t).ToList();
    }

    private async Task LoadHistoricalLogs()
    {
        _loading = true;
        StateHasChanged();

        _historicalLogs = await SessionRepository.GetFilteredLogsAsync(_sessionFilter, _engineFilter);

        _loading = false;
        StateHasChanged();
    }

    private async Task OnFilterChanged()
    {
        await LoadHistoricalLogs();
    }

    private void OnIncludeLiveChanged()
    {
        if (_includeLive)
        {
            LogAggregator.OnLogReceived += HandleLogReceived;
        }
        else
        {
            LogAggregator.OnLogReceived -= HandleLogReceived;
            lock (_liveEntries)
            {
                _liveEntries.Clear();
            }
        }
    }

    private async void HandleLogReceived(AggregatedLogEntry entry)
    {
        lock (_liveEntries)
        {
            _liveEntries.AddLast(entry);
            while (_liveEntries.Count > MaxLiveEntries) _liveEntries.RemoveFirst();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void HandleStateChanged()
    {
        await InvokeAsync(async () =>
        {
            await RefreshOptionsFromDb();
            StateHasChanged();
        });
    }

    private IEnumerable<string> GetFilteredLines()
    {
        // Historical logs first
        foreach (var log in _historicalLogs)
        {
            if (!string.IsNullOrEmpty(_engineFilter) && log.EnginePodName != _engineFilter)
                continue;
            if (!string.IsNullOrEmpty(_sessionFilter) && log.SessionToken != _sessionFilter)
                continue;

            var formatted = $"[{log.EnginePodName}/{ShortToken(log.SessionToken)}] {log.Message}";

            if (!string.IsNullOrEmpty(_textSearch) && !formatted.Contains(_textSearch, StringComparison.OrdinalIgnoreCase))
                continue;

            yield return formatted;
        }

        // Live entries after historical
        if (_includeLive)
        {
            List<AggregatedLogEntry> snapshot;
            lock (_liveEntries)
            {
                snapshot = _liveEntries.ToList();
            }

            foreach (var entry in snapshot)
            {
                if (!string.IsNullOrEmpty(_engineFilter) && entry.EnginePodName != _engineFilter)
                    continue;
                if (!string.IsNullOrEmpty(_sessionFilter) && entry.SessionToken != _sessionFilter)
                    continue;

                var formatted = $"[{entry.EnginePodName}/{ShortToken(entry.SessionToken)}] {entry.Message}";

                if (!string.IsNullOrEmpty(_textSearch) && !formatted.Contains(_textSearch, StringComparison.OrdinalIgnoreCase))
                    continue;

                yield return formatted;
            }
        }
    }

    private static string ShortToken(string token) => token.Length > 8 ? token[..8] : token;

    public void Dispose()
    {
        if (_includeLive)
            LogAggregator.OnLogReceived -= HandleLogReceived;
        StateStore.OnStateChanged -= HandleStateChanged;
    }
}
