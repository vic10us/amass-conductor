@page "/engine/{PodName}"
@implements IDisposable
@inject EngineStateStore StateStore
@inject IEnumerationService EnumerationService
@inject ISessionRepository SessionRepository
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject IOptions<AmassOrchestrator.Web.Configuration.OrchestratorOptions> Options
@using Microsoft.Extensions.Options
@using System.Text.Json

<PageTitle>@PodName - Amass Conductor</PageTitle>

<RadzenBreadCrumb>
    <RadzenBreadCrumbItem Text="Dashboard" Path="" />
    <RadzenBreadCrumbItem Text="@PodName" />
</RadzenBreadCrumb>

@if (_state == null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="rz-mt-4">
        Engine pod "@PodName" not found. It may have been removed.
    </RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-4 rz-mb-4">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@_state.Pod.PodName</RadzenText>
        <HealthBadge IsHealthy="@_state.IsHealthy" IsReady="@_state.Pod.IsReady" />
        @if (_state.AnnotationInfo is not null)
        {
            @if (_state.AnnotationInfo.CheckStatus == IpCheckStatus.Error)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Tor ?" />
            }
            else if (_state.AnnotationInfo.IsTor == true)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Tor" />
            }
            else if (_state.AnnotationInfo.IsTor == false)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Direct" />
            }
        }
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
        IP: @_state.Pod.PodIP | Phase: @_state.Pod.Phase | Ordinal: @_state.Pod.Ordinal
    </RadzenText>

    @if (_state.AnnotationInfo is not null)
    {
        <RadzenCard class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mb-2">Network Info</RadzenText>
            @if (_state.AnnotationInfo.PublicIP is not null)
            {
                <RadzenText TextStyle="TextStyle.Body2">Public IP: @_state.AnnotationInfo.PublicIP</RadzenText>
            }
            @if (_state.AnnotationInfo.CheckStatus == IpCheckStatus.Error)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Check Failed" />
                @if (_state.AnnotationInfo.CheckError is not null)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">@_state.AnnotationInfo.CheckError</RadzenText>
                }
            }
            @if (_state.AnnotationInfo.IsTor == true)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">Connection: Tor</RadzenText>
            }
            else if (_state.AnnotationInfo.IsTor == false)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-1">Connection: Direct</RadzenText>
            }
            @if (_state.AnnotationInfo.CheckedAtUtc is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-mt-1">Last checked: @_state.AnnotationInfo.CheckedAtUtc.Value.ToString("u")</RadzenText>
            }
        </RadzenCard>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mb-4">
        <RadzenButton Text="Create Session" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@ShowCreateDialog" />
        <RadzenButton Text="New Enumeration (Auto)" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Click="@StartAutoEnumeration" />
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.H5" class="rz-mb-2">Sessions (@_sessions.Count)</RadzenText>

    @if (_sessions.Count == 0)
    {
        <RadzenText>No active sessions.</RadzenText>
    }
    else
    {
        <RadzenDataGrid TItem="SessionInfo" Data="@_sessions" AllowPaging="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="SessionInfo" Title="Token" Width="320px">
                    <Template Context="session">
                        <RadzenLink Path="@($"session/{session.Token}")" Text="@session.Token" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SessionInfo" Title="Progress">
                    <Template Context="session">
                        <ProgressBar Completed="@session.WorkItemsCompleted" Total="@session.WorkItemsTotal" IsCompleted="@session.IsCompleted" ItemsPerSecond="@session.ItemsPerSecond" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="SessionInfo" Title="Actions" Width="120px">
                    <Template Context="session">
                        <SessionControls PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort" SessionToken="@session.Token" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@code {
    [Parameter] public string PodName { get; set; } = string.Empty;

    private EngineInstanceState? _state;
    private readonly List<SessionInfo> _sessions = [];

    protected override void OnInitialized()
    {
        _state = StateStore.GetState(Uri.UnescapeDataString(PodName));
        SyncSessions();
        StateStore.OnStateChanged += HandleStateChanged;
    }

    private void SyncSessions()
    {
        _sessions.Clear();
        if (_state?.Sessions is { } sessions)
        {
            _sessions.AddRange(sessions);
        }
    }

    private async void HandleStateChanged()
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(() =>
            {
                _state = StateStore.GetState(Uri.UnescapeDataString(PodName));
                SyncSessions();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async Task ShowCreateDialog()
    {
        if (_state == null) return;

        var result = await DialogService.OpenAsync<CreateSessionDialog>("Create Session",
            options: new DialogOptions { Width = "750px" });

        if (result is CreateSessionDialogResult dialogResult)
        {
            // Force target to this specific engine
            dialogResult.TargetEnginePodName = Uri.UnescapeDataString(PodName);
            var enumResult = await RunWithProgressDialog(dialogResult, forceTargetEngine: true);
            HandleEnumerationResult(enumResult, dialogResult);
        }
    }

    private async Task StartAutoEnumeration()
    {
        var result = await DialogService.OpenAsync<CreateSessionDialog>("New Enumeration (Auto)",
            options: new DialogOptions { Width = "750px" });

        if (result is CreateSessionDialogResult dialogResult)
        {
            var enumResult = await RunWithProgressDialog(dialogResult);
            HandleEnumerationResult(enumResult, dialogResult);
        }
    }

    private async Task<EnumerationResult?> RunWithProgressDialog(CreateSessionDialogResult dialogResult, bool forceTargetEngine = false)
    {
        var targetEngine = forceTargetEngine
            ? dialogResult.TargetEnginePodName
            : (dialogResult.UseSameEngine ? dialogResult.TargetEnginePodName : null);

        var parameters = new Dictionary<string, object?>
        {
            { nameof(SessionProgressDialog.Config), dialogResult.Config },
            { nameof(SessionProgressDialog.SeedAssets), dialogResult.Assets },
            { nameof(SessionProgressDialog.SubmitDomainsAsFqdns), dialogResult.SubmitDomainsAsFqdnAssets },
            { nameof(SessionProgressDialog.TargetEnginePodName), targetEngine },
        };

        var result = await DialogService.OpenAsync<SessionProgressDialog>("Creating Session",
            parameters,
            new DialogOptions { ShowClose = false, CloseDialogOnEsc = false, Width = "500px" });

        return result as EnumerationResult;
    }

    private async void HandleEnumerationResult(EnumerationResult? enumResult, CreateSessionDialogResult dialogResult)
    {
        if (enumResult is null) return;

        if (enumResult.Success)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Enumeration started",
                $"Session {enumResult.SessionToken} on {enumResult.EnginePodName}");
        }
        else
        {
            var errorMessage = enumResult.ErrorMessage ?? "Unknown error";
            NotificationService.Notify(NotificationSeverity.Error, "Enumeration failed", errorMessage);
            var persistedData = new PersistedSessionData
            {
                Config = dialogResult.Config,
                Assets = dialogResult.Assets,
                SubmitDomainsAsFqdns = dialogResult.SubmitDomainsAsFqdnAssets
            };
            await SessionRepository.CreateFailedAsync(dialogResult.Config.Scope?.Domains ?? [], persistedData.Serialize(), errorMessage);
        }
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        StateStore.OnStateChanged -= HandleStateChanged;
    }
}
