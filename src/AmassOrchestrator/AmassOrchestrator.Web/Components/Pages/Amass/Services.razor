@page "/assets/services"
@inject IServiceProvider ServiceProvider

<PageTitle>Services - Amass Conductor</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Services</RadzenText>
    <RadzenTextBox @bind-Value="_search" Placeholder="Search services..." Change="@(_ => LoadPageAsync(0))" Style="width: 300px;" />
</RadzenStack>

@if (_error != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat">@_error</RadzenAlert>
}

@if (_initialLoading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenDataGrid Data="@_items" TItem="ServiceAsset"
                    AllowPaging="true" PageSize="@PageSize" Count="@_count"
                    IsLoading="@_loading" Density="Density.Compact" Style="width: 100%;"
                    LoadData="@OnLoadData">
        <Columns>
            <RadzenDataGridColumn TItem="ServiceAsset" Property="ServiceType" Title="Service Type" Width="200px" />
            <RadzenDataGridColumn TItem="ServiceAsset" Property="UniqueId" Title="Unique ID" />
            <RadzenDataGridColumn TItem="ServiceAsset" Property="CreatedAt" Title="Created" Width="180px">
                <Template Context="s">@s.CreatedAt.ToString("yyyy-MM-dd HH:mm")</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private const int PageSize = 50;
    private IAmassDataService? _service;
    private List<ServiceAsset> _items = [];
    private int _count;
    private bool _initialLoading = true;
    private bool _loading;
    private string? _search;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _service = ServiceProvider.GetService<IAmassDataService>();
        await LoadPageAsync(0);
        _initialLoading = false;
    }

    private async Task LoadPageAsync(int skip)
    {
        if (_service == null) return;
        _loading = true;
        _error = null;
        try
        {
            var (items, count) = await _service.GetServicesAsync(skip, PageSize, _search);
            _items = items;
            _count = count;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async Task OnLoadData(LoadDataArgs args)
    {
        await LoadPageAsync(args.Skip ?? 0);
    }
}
