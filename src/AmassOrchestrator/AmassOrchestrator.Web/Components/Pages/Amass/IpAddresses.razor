@page "/assets/ips"
@inject IServiceProvider ServiceProvider

<PageTitle>IP Addresses - Amass Conductor</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">IP Addresses</RadzenText>
    <RadzenTextBox @bind-Value="_search" Placeholder="Search IPs..." Change="@(_ => LoadPageAsync(0))" Style="width: 300px;" />
</RadzenStack>

@if (_error != null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat">@_error</RadzenAlert>
}

@if (_initialLoading)
{
    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}
else
{
    <RadzenDataGrid Data="@_items" TItem="IpAddressAsset"
                    AllowPaging="true" PageSize="@PageSize" Count="@_count"
                    IsLoading="@_loading" Density="Density.Compact" Style="width: 100%;"
                    LoadData="@OnLoadData"
                    RowExpand="@OnRowExpand" ExpandMode="DataGridExpandMode.Single">
        <Template Context="ip">
            <RadzenStack Gap="1rem">
                @if (_relatedFqdns.TryGetValue(ip.Id, out var fqdns) && fqdns.Any())
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Related FQDNs</RadzenText>
                        <RadzenDataGrid Data="@fqdns" TItem="RelatedFqdn" Density="Density.Compact" Style="width: 100%;">
                            <Columns>
                                <RadzenDataGridColumn TItem="RelatedFqdn" Title="FQDN" Width="300px">
                                    <Template Context="f">
                                        <RadzenLink Text="@f.Fqdn" Path="assets/fqdns" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RelatedFqdn" Property="EdgeLabel" Title="Relation" Width="180px" />
                                <RadzenDataGridColumn TItem="RelatedFqdn" Property="CreatedAt" Title="Created" Width="180px">
                                    <Template Context="f">@f.CreatedAt.ToString("yyyy-MM-dd HH:mm")</Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
                @if (_relatedNetblocks.TryGetValue(ip.Id, out var nbs) && nbs.Any())
                {
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-2">Related Netblocks</RadzenText>
                        <RadzenDataGrid Data="@nbs" TItem="RelatedNetblock" Density="Density.Compact" Style="width: 100%;">
                            <Columns>
                                <RadzenDataGridColumn TItem="RelatedNetblock" Title="CIDR" Width="200px">
                                    <Template Context="nb">
                                        <RadzenLink Text="@nb.Cidr" Path="assets/netblocks" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="RelatedNetblock" Property="EdgeLabel" Title="Relation" Width="180px" />
                                <RadzenDataGridColumn TItem="RelatedNetblock" Property="CreatedAt" Title="Created" Width="180px">
                                    <Template Context="nb">@nb.CreatedAt.ToString("yyyy-MM-dd HH:mm")</Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                }
                @if (_loadingRelated)
                {
                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                }
                else if (!(fqdns?.Any() == true) && !(nbs?.Any() == true))
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">No related assets found.</RadzenText>
                }
            </RadzenStack>
        </Template>
        <Columns>
            <RadzenDataGridColumn TItem="IpAddressAsset" Title="IP Address">
                <Template Context="ip">@ip.IpAddress</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="IpAddressAsset" Property="CreatedAt" Title="Created" Width="180px">
                <Template Context="ip">@ip.CreatedAt.ToString("yyyy-MM-dd HH:mm")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="IpAddressAsset" Property="UpdatedAt" Title="Updated" Width="180px">
                <Template Context="ip">@ip.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@code {
    private const int PageSize = 50;
    private IAmassDataService? _service;
    private List<IpAddressAsset> _items = [];
    private int _count;
    private bool _initialLoading = true;
    private bool _loading;
    private bool _loadingRelated;
    private string? _search;
    private string? _error;
    private Dictionary<long, List<RelatedFqdn>> _relatedFqdns = new();
    private Dictionary<long, List<RelatedNetblock>> _relatedNetblocks = new();

    protected override async Task OnInitializedAsync()
    {
        _service = ServiceProvider.GetService<IAmassDataService>();
        await LoadPageAsync(0);
        _initialLoading = false;
    }

    private async Task LoadPageAsync(int skip)
    {
        if (_service == null) return;
        _loading = true;
        _error = null;
        try
        {
            var (items, count) = await _service.GetIpAddressesAsync(skip, PageSize, _search);
            _items = items;
            _count = count;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loading = false;
    }

    private async Task OnLoadData(LoadDataArgs args)
    {
        await LoadPageAsync(args.Skip ?? 0);
    }

    private async void OnRowExpand(IpAddressAsset ip)
    {
        if (_service == null || _relatedFqdns.ContainsKey(ip.Id)) return;
        _loadingRelated = true;
        try
        {
            _relatedFqdns[ip.Id] = await _service.GetRelatedFqdnsForIpAsync(ip.Id);
            _relatedNetblocks[ip.Id] = await _service.GetRelatedNetblocksForIpAsync(ip.Id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _loadingRelated = false;
        await InvokeAsync(StateHasChanged);
    }
}
