@page "/engine/{PodName}/session/{SessionToken}"
@implements IDisposable
@inject EngineStateStore StateStore
@inject IOptions<AmassOrchestrator.Web.Configuration.OrchestratorOptions> Options
@inject ISessionRepository SessionRepository
@inject IEnumerationService EnumerationService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@using Microsoft.Extensions.Options
@using System.Text.Json
@using AmassOrchestrator.Web.Models
@using AmassOrchestrator.Web.Services

<PageTitle>Session @ShortToken - Amass Conductor</PageTitle>

<RadzenBreadCrumb>
    <RadzenBreadCrumbItem Text="Dashboard" Path="" />
    <RadzenBreadCrumbItem Text="@PodName" Path="@($"engine/{Uri.EscapeDataString(PodName)}")" />
    <RadzenBreadCrumbItem Text="@ShortToken" />
</RadzenBreadCrumb>

@if (_state != null && _session != null)
{
    <!-- Live session view -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-4 rz-mb-4">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Session @ShortToken</RadzenText>
        <SessionControls PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort" SessionToken="@SessionToken"
                         OnSessionStopped="@(() => Navigation.NavigateTo($"engine/{Uri.EscapeDataString(PodName)}"))" />
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
        Full token: @SessionToken
    </RadzenText>

    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Stats">
                <div class="rz-p-4">
                    @if (_session.IsCompleted)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" class="rz-mb-4">
                            Enumeration completed.
                        </RadzenAlert>
                    }
                    <ProgressBar Completed="@_session.WorkItemsCompleted" Total="@_session.WorkItemsTotal" IsCompleted="@_session.IsCompleted" ItemsPerSecond="@_session.ItemsPerSecond" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">
                        Progress: @_session.ProgressPercent%
                    </RadzenText>
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Logs">
                <div class="rz-p-4">
                    @if (_session.IsCompleted)
                    {
                        <RadzenCard>
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-2">
                                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Historical Logs</RadzenText>
                            </RadzenStack>
                            <pre style="max-height: 400px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px; font-size: 0.85rem;">@string.Join("\n", _historicalLogs)</pre>
                        </RadzenCard>
                    }
                    else
                    {
                        <LogViewer PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort" SessionToken="@SessionToken" />
                    }
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Scope">
                <div class="rz-p-4">
                    <RadzenStack Gap="1rem">
                        @foreach (var assetType in _assetTypes)
                        {
                            <ScopeTable PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort"
                                        SessionToken="@SessionToken" AssetType="@assetType" />
                        }
                    </RadzenStack>
                </div>
            </RadzenTabsItem>
            @if (_config != null)
            {
                <RadzenTabsItem Text="Configuration">
                    <div class="rz-p-4">
                        @ConfigurationContent
                    </div>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
else if (_dbRecord != null)
{
    <!-- Historical session view (session no longer on engine) -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-4 rz-mb-4">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Session @ShortToken</RadzenText>
        @if (_dbRecord.IsFailed)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
        }
        else if (_dbRecord.IsCancelled)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Cancelled" />
        }
        else if (_dbRecord.IsCompleted)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Completed" />
        }
        else
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Historical" />
        }
        @if (_dbRecord.IsFailed || _dbRecord.IsCancelled)
        {
            <RadzenButton Text="Retry" Icon="replay" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@RetrySession" />
            <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DeleteSessionRecord" />
        }
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
        Full token: @SessionToken
    </RadzenText>

    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Stats">
                <div class="rz-p-4">
                    @if (_dbRecord.IsFailed)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" class="rz-mb-4">
                            @(_dbRecord.ErrorMessage ?? "Enumeration failed.")
                        </RadzenAlert>
                    }
                    else if (_dbRecord.IsCancelled)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" class="rz-mb-4">
                            Enumeration was cancelled.
                        </RadzenAlert>
                    }
                    else if (_dbRecord.IsCompleted)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" class="rz-mb-4">
                            Enumeration completed.
                        </RadzenAlert>
                    }
                    <ProgressBar Completed="@_dbRecord.WorkItemsCompleted" Total="@_dbRecord.WorkItemsTotal" IsCompleted="@_dbRecord.IsCompleted" IsFailed="@_dbRecord.IsFailed" IsCancelled="@_dbRecord.IsCancelled" />
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">
                        Engine: @_dbRecord.EnginePodName
                    </RadzenText>
                    @if (_dbRecord.CompletedAtUtc.HasValue)
                    {
                        <RadzenText TextStyle="TextStyle.Body2">
                            Completed: @_dbRecord.CompletedAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss UTC")
                        </RadzenText>
                        @if (HistoricalThroughput > 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2">
                                Avg throughput: @HistoricalThroughput items/s
                            </RadzenText>
                        }
                    }
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Logs">
                <div class="rz-p-4">
                    <RadzenCard>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-2">
                            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Historical Logs</RadzenText>
                        </RadzenStack>
                        <pre style="max-height: 400px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px; font-size: 0.85rem;">@string.Join("\n", _historicalLogs)</pre>
                    </RadzenCard>
                </div>
            </RadzenTabsItem>
            @if (_config != null)
            {
                <RadzenTabsItem Text="Configuration">
                    <div class="rz-p-4">
                        @ConfigurationContent
                    </div>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="rz-mt-4">
        Session not found. It may have been terminated.
    </RadzenAlert>
}

@code {
    [Parameter] public string PodName { get; set; } = string.Empty;
    [Parameter] public string SessionToken { get; set; } = string.Empty;

    private string ShortToken => SessionToken.Length > 8 ? SessionToken[..8] + "..." : SessionToken;

    private EngineInstanceState? _state;
    private SessionInfo? _session;
    private SessionRecord? _dbRecord;
    private List<string> _historicalLogs = [];
    private AmassConfig? _config;
    private SeedAssets? _assets;
    private bool _submitDomainsAsFqdns;

    private static readonly string[] _assetTypes = ["fqdn", "ipaddress", "autonomoussystem", "netblock", "location", "organization"];

    private double HistoricalThroughput
    {
        get
        {
            if (_dbRecord?.CompletedAtUtc == null || _dbRecord.WorkItemsCompleted <= 0) return 0;
            var duration = (_dbRecord.CompletedAtUtc.Value - _dbRecord.CreatedAtUtc).TotalSeconds;
            return duration > 0 ? Math.Round(_dbRecord.WorkItemsCompleted / duration, 2) : 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        RefreshState();
        StateStore.OnStateChanged += HandleStateChanged;

        if (_state == null || _session == null)
        {
            // Session not in live state — load from DB
            _dbRecord = await SessionRepository.GetByTokenAsync(SessionToken);
            await LoadHistoricalLogs();
        }
        else if (_session.IsCompleted)
        {
            await LoadHistoricalLogs();
        }

        await LoadConfig();
    }

    private async Task LoadConfig()
    {
        var json = await SessionRepository.GetConfigJsonAsync(SessionToken);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var data = PersistedSessionData.Deserialize(json);
                _config = data.Config;
                _assets = data.Assets;
                _submitDomainsAsFqdns = data.SubmitDomainsAsFqdns;
            }
            catch
            {
                // Config JSON is malformed — leave _config null
            }
        }
    }

    private async Task LoadHistoricalLogs()
    {
        var logs = await SessionRepository.GetLogsAsync(SessionToken);
        _historicalLogs = logs.Select(l => l.Message).ToList();
    }

    private void RefreshState()
    {
        _state = StateStore.GetState(Uri.UnescapeDataString(PodName));
        _session = _state?.Sessions.FirstOrDefault(s => s.Token == SessionToken);
    }

    private async void HandleStateChanged()
    {
        var wasCompleted = _session?.IsCompleted ?? false;
        var hadLiveState = _state != null && _session != null;
        RefreshState();

        if (hadLiveState && (_state == null || _session == null))
        {
            // Session disappeared from live state (auto-deleted) — switch to DB view
            _dbRecord = await SessionRepository.GetByTokenAsync(SessionToken);
            await LoadHistoricalLogs();
        }
        else if (_session?.IsCompleted == true && !wasCompleted)
        {
            await LoadHistoricalLogs();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task RetrySession()
    {
        if (_dbRecord == null) return;

        var configJson = await SessionRepository.GetConfigJsonAsync(SessionToken);
        if (string.IsNullOrEmpty(configJson))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No saved config", "Cannot retry — configuration not found.");
            return;
        }

        var data = PersistedSessionData.Deserialize(configJson);
        var config = data.Config;
        if (config == null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invalid config", "Cannot retry — configuration could not be parsed.");
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            { nameof(CreateSessionDialog.InitialConfig), config },
            { nameof(CreateSessionDialog.ShowEngineChoice), !string.IsNullOrEmpty(_dbRecord.EnginePodName) },
            { nameof(CreateSessionDialog.OriginalEnginePodName), _dbRecord.EnginePodName ?? string.Empty },
            { nameof(CreateSessionDialog.InitialAssets), data.Assets },
            { nameof(CreateSessionDialog.InitialSubmitDomainsAsFqdns), (bool?)data.SubmitDomainsAsFqdns }
        };

        var result = await DialogService.OpenAsync<CreateSessionDialog>(
            "Retry Enumeration",
            parameters,
            new DialogOptions { Width = "80%" });

        if (result is CreateSessionDialogResult dialogResult)
        {
            var newConfig = dialogResult.Config;
            var enumResult = dialogResult.UseSameEngine && !string.IsNullOrEmpty(dialogResult.TargetEnginePodName)
                ? await EnumerationService.StartEnumerationOnEngineAsync(dialogResult.TargetEnginePodName, newConfig, dialogResult.Assets, dialogResult.SubmitDomainsAsFqdnAssets)
                : await EnumerationService.StartEnumerationAsync(newConfig, dialogResult.Assets, dialogResult.SubmitDomainsAsFqdnAssets);

            if (enumResult.Success)
            {
                await SessionRepository.DeleteAsync(SessionToken);
                await SessionRepository.DeleteLogsAsync(SessionToken);
                NotificationService.Notify(NotificationSeverity.Success, "Enumeration started",
                    $"Session {enumResult.SessionToken} on {enumResult.EnginePodName}");
                Navigation.NavigateTo("sessions");
            }
            else
            {
                var errorMessage = enumResult.ErrorMessage ?? "Unknown error";
                NotificationService.Notify(NotificationSeverity.Error, "Enumeration failed", errorMessage);
                var persistedData = new PersistedSessionData
                {
                    Config = newConfig,
                    Assets = dialogResult.Assets,
                    SubmitDomainsAsFqdns = dialogResult.SubmitDomainsAsFqdnAssets
                };
                await SessionRepository.CreateFailedAsync(newConfig.Scope?.Domains ?? [], persistedData.Serialize(), errorMessage);
            }
        }
    }

    private async Task DeleteSessionRecord()
    {
        var confirmed = await DialogService.Confirm("Delete this session record?", "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed != true) return;

        await SessionRepository.DeleteAsync(SessionToken);
        await SessionRepository.DeleteLogsAsync(SessionToken);
        NotificationService.Notify(NotificationSeverity.Success, "Session deleted");
        Navigation.NavigateTo("sessions");
    }

    private static string MaskSecret(string? value)
        => string.IsNullOrEmpty(value) ? "—" : value.Length <= 4 ? "****" : value[..2] + new string('*', value.Length - 4) + value[^2..];

    private static string FormatCidr(IpNet net)
    {
        if (net.Ip == null || net.Mask == null) return string.Empty;
        var addr = new System.Net.IPAddress(net.Ip);
        int prefix = 0;
        foreach (var b in net.Mask)
        {
            for (int i = 7; i >= 0; i--)
            {
                if ((b & (1 << i)) != 0) prefix++;
                else break;
            }
        }
        return $"{addr}/{prefix}";
    }

    private RenderFragment ConfigurationContent => __builder =>
    {
        <RadzenStack Gap="1.5rem">
            @* ── Domains ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Domains</RadzenText>
                @if (_config!.Scope?.Domains is { Count: > 0 } domains)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @foreach (var d in domains)
                        {
                            <RadzenBadge Text="@d" BadgeStyle="BadgeStyle.Primary" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                }
            </RadzenCard>

            @* ── ASNs ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">ASNs</RadzenText>
                @if (_config!.Scope?.Asns is { Count: > 0 } asns)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @foreach (var asn in asns)
                        {
                            <RadzenBadge Text="@asn.ToString()" BadgeStyle="BadgeStyle.Info" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                }
            </RadzenCard>

            @* ── CIDRs ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">CIDRs</RadzenText>
                @if (_config.Scope?.Cidrs is { Count: > 0 } cidrs)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @foreach (var cidr in cidrs)
                        {
                            <RadzenBadge Text="@FormatCidr(cidr)" BadgeStyle="BadgeStyle.Info" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                }
            </RadzenCard>

            @* ── IPs ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">IPs</RadzenText>
                @if (_config.Scope?.Ips is { Count: > 0 } ips)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @foreach (var ip in ips)
                        {
                            <RadzenBadge Text="@(new System.Net.IPAddress(ip).ToString())" BadgeStyle="BadgeStyle.Info" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                }
            </RadzenCard>

            @* ── Ports ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Ports</RadzenText>
                @if (_config.Scope?.Ports is { Count: > 0 } ports)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @foreach (var port in ports)
                        {
                            <RadzenBadge Text="@port.ToString()" BadgeStyle="BadgeStyle.Light" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                }
            </RadzenCard>

            @* ── Blacklist ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Blacklist</RadzenText>
                @if (_config.Scope?.Blacklist is { Count: > 0 } blacklist)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        @foreach (var item in blacklist)
                        {
                            <RadzenBadge Text="@item" BadgeStyle="BadgeStyle.Danger" />
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                }
            </RadzenCard>

            @* ── Options ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Options</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenBadge Text="Active" BadgeStyle="@(_config.Active == true ? BadgeStyle.Success : BadgeStyle.Light)" />
                    <RadzenBadge Text="Brute Force" BadgeStyle="@(_config.BruteForce == true ? BadgeStyle.Success : BadgeStyle.Light)" />
                    <RadzenBadge Text="Alterations" BadgeStyle="@(_config.Alterations == true ? BadgeStyle.Success : BadgeStyle.Light)" />
                    <RadzenBadge Text="Rigid Boundaries" BadgeStyle="@(_config.RigidBoundaries == true ? BadgeStyle.Success : BadgeStyle.Light)" />
                    <RadzenBadge Text="Submit Domains as FQDN Assets" BadgeStyle="@(_submitDomainsAsFqdns ? BadgeStyle.Success : BadgeStyle.Light)" />
                </RadzenStack>
            </RadzenCard>

            @* ── Wordlists ── *@
            @if (_config.Wordlist is { Count: > 0 })
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Brute Force Wordlist</RadzenText>
                    <pre style="max-height: 150px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px; font-size: 0.85rem;">@string.Join("\n", _config.Wordlist)</pre>
                </RadzenCard>
            }
            @if (_config.AltWorldlist is { Count: > 0 })
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Alterations Wordlist</RadzenText>
                    <pre style="max-height: 150px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px; font-size: 0.85rem;">@string.Join("\n", _config.AltWorldlist)</pre>
                </RadzenCard>
            }

            @* ── Database ── *@
            @if (_config.Database is { Count: > 0 })
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Database</RadzenText>
                    @foreach (var db in _config.Database)
                    {
                        <RadzenStack Gap="0.25rem" class="rz-mb-2">
                            <RadzenText TextStyle="TextStyle.Body2"><strong>System:</strong> @(db.System ?? "—")</RadzenText>
                            @if (!string.IsNullOrWhiteSpace(db.Url))
                            {
                                <RadzenText TextStyle="TextStyle.Body2"><strong>URL:</strong> @db.Url</RadzenText>
                            }
                            <RadzenText TextStyle="TextStyle.Body2"><strong>Host:</strong> @(db.Host ?? "—"):@(db.Port ?? "—")</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>Database:</strong> @(db.DbName ?? "—")</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>Username:</strong> @(db.Username ?? "—")</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2"><strong>Password:</strong> @MaskSecret(db.Password)</RadzenText>
                            @if (!string.IsNullOrWhiteSpace(db.Options))
                            {
                                <RadzenText TextStyle="TextStyle.Body2"><strong>Options:</strong> @db.Options</RadzenText>
                            }
                            @if (db.Primary == true)
                            {
                                <RadzenBadge Text="Primary" BadgeStyle="BadgeStyle.Info" />
                            }
                        </RadzenStack>
                    }
                </RadzenCard>
            }

            @* ── Datasources ── *@
            @if (_config.DatasourceConfig != null)
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Datasources</RadzenText>
                    @{
                        var yaml = DatasourceConfigParser.Serialize(_config.DatasourceConfig);
                    }
                    @if (!string.IsNullOrWhiteSpace(yaml))
                    {
                        <pre style="max-height: 300px; overflow-y: auto; background: #1e1e1e; color: #d4d4d4; padding: 0.75rem; border-radius: 4px; font-size: 0.85rem;">@yaml</pre>
                    }
                </RadzenCard>
            }

            @* ── Transformations ── *@
            @if (_config.Transformations is { Count: > 0 })
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Transformations</RadzenText>
                    <RadzenDataGrid Data="@_config.Transformations.Select(kv => new { Name = kv.Key, kv.Value.Priority, kv.Value.Confidence, kv.Value.Ttl })" TItem="object" Density="Density.Compact">
                        <Columns>
                            <RadzenDataGridColumn Property="Name" Title="Name" />
                            <RadzenDataGridColumn Property="Priority" Title="Priority" Width="100px" />
                            <RadzenDataGridColumn Property="Confidence" Title="Confidence" Width="100px" />
                            <RadzenDataGridColumn Property="Ttl" Title="TTL" Width="100px" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            }

            @* ── Seed Assets ── *@
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Seed Assets</RadzenText>
                <RadzenStack Gap="0.75rem">
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">FQDNs</RadzenText>
                        @if (_assets?.Fqdns is { Count: > 0 } fqdns)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                @foreach (var fqdn in fqdns)
                                {
                                    <RadzenBadge Text="@fqdn" BadgeStyle="BadgeStyle.Primary" />
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                        }
                    </div>
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">IP Addresses</RadzenText>
                        @if (_assets?.IpAddresses is { Count: > 0 } assetIps)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                @foreach (var ip in assetIps)
                                {
                                    <RadzenBadge Text="@ip" BadgeStyle="BadgeStyle.Info" />
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                        }
                    </div>
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Autonomous Systems</RadzenText>
                        @if (_assets?.AutonomousSystems is { Count: > 0 } assetAsns)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                @foreach (var asn in assetAsns)
                                {
                                    <RadzenBadge Text="@($"AS{asn}")" BadgeStyle="BadgeStyle.Info" />
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                        }
                    </div>
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Netblocks</RadzenText>
                        @if (_assets?.Netblocks is { Count: > 0 } netblocks)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                @foreach (var nb in netblocks)
                                {
                                    <RadzenBadge Text="@nb" BadgeStyle="BadgeStyle.Info" />
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                        }
                    </div>
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Organizations</RadzenText>
                        @if (_assets?.Organizations is { Count: > 0 } orgs)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                @foreach (var org in orgs)
                                {
                                    <RadzenBadge Text="@org" BadgeStyle="BadgeStyle.Secondary" />
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                        }
                    </div>
                    <div>
                        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Locations</RadzenText>
                        @if (_assets?.Locations is { Count: > 0 } locs)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                                @foreach (var loc in locs)
                                {
                                    <RadzenBadge Text="@loc" BadgeStyle="BadgeStyle.Secondary" />
                                }
                            </RadzenStack>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-color-secondary">None</RadzenText>
                        }
                    </div>
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
    };

    public void Dispose()
    {
        StateStore.OnStateChanged -= HandleStateChanged;
    }
}
