@page "/session/{SessionToken}"
@page "/session/{SessionToken}/{Tab?}"
@implements IDisposable
@inject EngineStateStore StateStore
@inject IOptions<AmassOrchestrator.Web.Configuration.OrchestratorOptions> Options
@inject ISessionRepository SessionRepository
@inject IEnumerationService EnumerationService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager Navigation
@using Microsoft.Extensions.Options
@using System.Text.Json
@using AmassOrchestrator.Web.Models
@using AmassOrchestrator.Web.Services

<PageTitle>Session @ShortToken - Amass Conductor</PageTitle>

<RadzenBreadCrumb>
    <RadzenBreadCrumbItem Text="Dashboard" Path="" />
    @if (_session != null)
    {
        <RadzenBreadCrumbItem Text="@_podName" Path="@($"engine/{Uri.EscapeDataString(_podName)}")" />
    }
    else
    {
        <RadzenBreadCrumbItem Text="Sessions" Path="sessions" />
    }
    <RadzenBreadCrumbItem Text="@ShortToken" />
</RadzenBreadCrumb>

@if (_isLoading)
{
    <div class="rz-mt-8 rz-text-align-center">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
    </div>
}
else if (_state != null && _session != null)
{
    <!-- Live session view -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-4 rz-mb-4">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Session @ShortToken</RadzenText>
        <SessionControls PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort" SessionToken="@SessionToken"
                         OnSessionStopped="@(() => Navigation.NavigateTo($"engine/{Uri.EscapeDataString(_podName)}"))" />
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
        Full token: @SessionToken
    </RadzenText>

    <RadzenTabs SelectedIndex="@TabNameToIndex(Tab)" Change="@OnTabChanged">
        <Tabs>
            <RadzenTabsItem Text="Stats">
                <SessionStatsTab Session="@_session" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Logs">
                <SessionLogsTab PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort" SessionToken="@SessionToken"
                                Session="@_session" HistoricalLogs="@_historicalLogs" IsLoading="@_isLoadingLogs" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Scope">
                <SessionScopeTab PodIp="@_state.Pod.PodIP" Port="@Options.Value.EnginePort" SessionToken="@SessionToken" />
            </RadzenTabsItem>
            @if (_config != null)
            {
                <RadzenTabsItem Text="Configuration">
                    <SessionConfigTab Config="@_config" Assets="@_assets" SubmitDomainsAsFqdns="@_submitDomainsAsFqdns" />
                </RadzenTabsItem>
            }
            else if (_isConfigLoading)
            {
                <RadzenTabsItem Text="Configuration">
                    <div class="rz-p-4 rz-text-align-center">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                    </div>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
else if (_dbRecord != null)
{
    <!-- Historical session view (session no longer on engine) -->
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-4 rz-mb-4">
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Session @ShortToken</RadzenText>
        @if (_dbRecord.IsFailed)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Failed" />
        }
        else if (_dbRecord.IsCancelled)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Cancelled" />
        }
        else if (_dbRecord.IsCompleted)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Completed" />
        }
        else
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Historical" />
        }
        @if (_dbRecord.IsFailed || _dbRecord.IsCancelled)
        {
            <RadzenButton Text="Retry" Icon="replay" ButtonStyle="ButtonStyle.Warning" Size="ButtonSize.Small" Click="@RetrySession" />
            <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@DeleteSessionRecord" />
        }
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-4">
        Full token: @SessionToken
    </RadzenText>

    <RadzenTabs SelectedIndex="@TabNameToIndex(Tab)" Change="@OnTabChanged">
        <Tabs>
            <RadzenTabsItem Text="Stats">
                <SessionStatsTab DbRecord="@_dbRecord" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Logs">
                <SessionLogsTab DbRecord="@_dbRecord" HistoricalLogs="@_historicalLogs" IsLoading="@_isLoadingLogs" />
            </RadzenTabsItem>
            @if (_config != null)
            {
                <RadzenTabsItem Text="Configuration">
                    <SessionConfigTab Config="@_config" Assets="@_assets" SubmitDomainsAsFqdns="@_submitDomainsAsFqdns" />
                </RadzenTabsItem>
            }
            else if (_isConfigLoading)
            {
                <RadzenTabsItem Text="Configuration">
                    <div class="rz-p-4 rz-text-align-center">
                        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                    </div>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="rz-mt-4">
        Session not found. It may have been terminated.
    </RadzenAlert>
}

@code {
    [Parameter] public string SessionToken { get; set; } = string.Empty;
    [Parameter] public string? Tab { get; set; }

    private string ShortToken => SessionToken.Length > 8 ? SessionToken[..8] + "..." : SessionToken;

    private bool _isLiveView => _state != null && _session != null;

    private string _podName = string.Empty;
    private EngineInstanceState? _state;
    private SessionInfo? _session;
    private SessionRecord? _dbRecord;
    private List<string> _historicalLogs = [];
    private AmassConfig? _config;
    private SeedAssets? _assets;
    private bool _submitDomainsAsFqdns;

    private bool _isLoading = true;
    private bool _isLoadingLogs = true;
    private bool _isConfigLoading = true;
    private bool _needsDataLoad = true;
    private string _loadedToken = string.Empty;

    private int TabNameToIndex(string? tab) => tab?.ToLowerInvariant() switch
    {
        "logs" => 1,
        "scope" => _isLiveView ? 2 : -1,
        "configuration" => _isLiveView ? 3 : 2,
        _ => 0
    };

    private string IndexToTabName(int index) => (_isLiveView, index) switch
    {
        (_, 0) => "stats",
        (_, 1) => "logs",
        (true, 2) => "scope",
        (true, 3) => "configuration",
        (false, 2) => "configuration",
        _ => "stats"
    };

    private void OnTabChanged(int index)
    {
        var tabName = IndexToTabName(index);
        Navigation.NavigateTo($"session/{SessionToken}/{tabName}", replace: true);
    }

    protected override void OnInitialized()
    {
        StateStore.OnStateChanged += HandleStateChanged;
    }

    protected override void OnParametersSet()
    {
        if (_loadedToken == SessionToken) return;

        // Reset state for new session
        _loadedToken = SessionToken;
        _dbRecord = null;
        _historicalLogs = [];
        _config = null;
        _assets = null;
        _submitDomainsAsFqdns = false;
        _isLoading = true;
        _isLoadingLogs = true;
        _isConfigLoading = true;
        _needsDataLoad = true;

        RefreshState();

        if (_state != null && _session != null)
        {
            _isLoading = false;
            if (!_session.IsCompleted)
                _isLoadingLogs = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsDataLoad) return;
        _needsDataLoad = false;

        if (_state == null || _session == null)
        {
            // Session not in live state — load DB record first for page structure
            _dbRecord = await SessionRepository.GetByTokenAsync(SessionToken);
            _podName = _dbRecord?.EnginePodName ?? string.Empty;
            _isLoading = false;
            StateHasChanged();

            // Load logs and config in parallel, updating UI as each completes
            var logsTask = LoadHistoricalLogs();
            var configTask = LoadConfig();
            await logsTask;
            _isLoadingLogs = false;
            StateHasChanged();
            await configTask;
            _isConfigLoading = false;
            StateHasChanged();
        }
        else
        {
            // Live session — load logs if completed, and config in parallel
            var tasks = new List<Task>();
            if (_session.IsCompleted)
            {
                tasks.Add(LoadHistoricalLogs().ContinueWith(_ => { _isLoadingLogs = false; InvokeAsync(StateHasChanged); }));
            }
            tasks.Add(LoadConfig().ContinueWith(_ => { _isConfigLoading = false; InvokeAsync(StateHasChanged); }));
            await Task.WhenAll(tasks);
            StateHasChanged();
        }
    }

    private async Task LoadConfig()
    {
        var json = await SessionRepository.GetConfigJsonAsync(SessionToken);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var data = PersistedSessionData.Deserialize(json);
                _config = data.Config;
                _assets = data.Assets;
                _submitDomainsAsFqdns = data.SubmitDomainsAsFqdns;
            }
            catch
            {
                // Config JSON is malformed — leave _config null
            }
        }
    }

    private async Task LoadHistoricalLogs()
    {
        var logs = await SessionRepository.GetLogsAsync(SessionToken);
        _historicalLogs = logs.Select(l => l.Message).ToList();
    }

    private void RefreshState()
    {
        foreach (var kvp in StateStore.States)
        {
            var match = kvp.Value.Sessions.FirstOrDefault(s => s.Token == SessionToken);
            if (match != null)
            {
                _state = kvp.Value;
                _session = match;
                _podName = _state.Pod.PodName;
                return;
            }
        }
        _state = null;
        _session = null;
        _podName = _dbRecord?.EnginePodName ?? string.Empty;
    }

    private async void HandleStateChanged()
    {
        if (_disposed) return;
        try
        {
            var wasCompleted = _session?.IsCompleted ?? false;
            var hadLiveState = _state != null && _session != null;
            RefreshState();

            if (hadLiveState && (_state == null || _session == null))
            {
                // Session disappeared from live state (auto-deleted) — switch to DB view
                _dbRecord = await SessionRepository.GetByTokenAsync(SessionToken);
                await LoadHistoricalLogs();
            }
            else if (_session?.IsCompleted == true && !wasCompleted)
            {
                await LoadHistoricalLogs();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task RetrySession()
    {
        if (_dbRecord == null) return;

        var configJson = await SessionRepository.GetConfigJsonAsync(SessionToken);
        if (string.IsNullOrEmpty(configJson))
        {
            NotificationService.Notify(NotificationSeverity.Warning, "No saved config", "Cannot retry — configuration not found.");
            return;
        }

        var data = PersistedSessionData.Deserialize(configJson);
        var config = data.Config;
        if (config == null)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invalid config", "Cannot retry — configuration could not be parsed.");
            return;
        }

        var parameters = new Dictionary<string, object?>
        {
            { nameof(CreateSessionDialog.InitialConfig), config },
            { nameof(CreateSessionDialog.ShowEngineChoice), !string.IsNullOrEmpty(_dbRecord.EnginePodName) },
            { nameof(CreateSessionDialog.OriginalEnginePodName), _dbRecord.EnginePodName ?? string.Empty },
            { nameof(CreateSessionDialog.InitialAssets), data.Assets },
            { nameof(CreateSessionDialog.InitialSubmitDomainsAsFqdns), (bool?)data.SubmitDomainsAsFqdns }
        };

        var result = await DialogService.OpenAsync<CreateSessionDialog>(
            "Retry Enumeration",
            parameters,
            new DialogOptions { Width = "80%" });

        if (result is CreateSessionDialogResult dialogResult)
        {
            var newConfig = dialogResult.Config;
            var enumResult = dialogResult.UseSameEngine && !string.IsNullOrEmpty(dialogResult.TargetEnginePodName)
                ? await EnumerationService.StartEnumerationOnEngineAsync(dialogResult.TargetEnginePodName, newConfig, dialogResult.Assets, dialogResult.SubmitDomainsAsFqdnAssets)
                : await EnumerationService.StartEnumerationAsync(newConfig, dialogResult.Assets, dialogResult.SubmitDomainsAsFqdnAssets);

            if (enumResult.Success)
            {
                await SessionRepository.DeleteAsync(SessionToken);
                await SessionRepository.DeleteLogsAsync(SessionToken);
                NotificationService.Notify(NotificationSeverity.Success, "Enumeration started",
                    $"Session {enumResult.SessionToken} on {enumResult.EnginePodName}");
                Navigation.NavigateTo("sessions");
            }
            else
            {
                var errorMessage = enumResult.ErrorMessage ?? "Unknown error";
                NotificationService.Notify(NotificationSeverity.Error, "Enumeration failed", errorMessage);
                var persistedData = new PersistedSessionData
                {
                    Config = newConfig,
                    Assets = dialogResult.Assets,
                    SubmitDomainsAsFqdns = dialogResult.SubmitDomainsAsFqdnAssets
                };
                await SessionRepository.CreateFailedAsync(newConfig.Scope?.Domains ?? [], persistedData.Serialize(), errorMessage);
            }
        }
    }

    private async Task DeleteSessionRecord()
    {
        var confirmed = await DialogService.Confirm("Delete this session record?", "Confirm Delete",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed != true) return;

        await SessionRepository.DeleteAsync(SessionToken);
        await SessionRepository.DeleteLogsAsync(SessionToken);
        NotificationService.Notify(NotificationSeverity.Success, "Session deleted");
        Navigation.NavigateTo("sessions");
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        StateStore.OnStateChanged -= HandleStateChanged;
    }
}
