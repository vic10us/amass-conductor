@page "/"
@implements IDisposable
@inject EngineStateStore StateStore
@inject IEnumerationService EnumerationService
@inject ISessionRepository SessionRepository
@inject DialogService DialogService
@inject NotificationService NotificationService
@using System.Text.Json

<PageTitle>Dashboard - Amass Orchestrator</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Engine Dashboard</RadzenText>
    <RadzenButton Text="New Enumeration" Icon="play_arrow" ButtonStyle="ButtonStyle.Success" Click="@StartEnumeration" />
</RadzenStack>

@if (!_states.Any())
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Shade="Shade.Lighter">
        No engine pods discovered. Check that the StatefulSet is running and the orchestrator configuration is correct.
    </RadzenAlert>
}
else
{
    <RadzenRow Gap="1rem">
        @foreach (var state in _states.OrderBy(s => s.Pod.Ordinal))
        {
            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                <EngineCard State="@state" />
            </RadzenColumn>
        }
    </RadzenRow>
}

@code {
    private IReadOnlyList<EngineInstanceState> _states = [];

    protected override void OnInitialized()
    {
        _states = StateStore.States.Values.ToList();
        StateStore.OnStateChanged += HandleStateChanged;
    }

    private async void HandleStateChanged()
    {
        _states = StateStore.States.Values.ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartEnumeration()
    {
        var result = await DialogService.OpenAsync<CreateSessionDialog>("New Enumeration",
            options: new DialogOptions { Width = "80%" });

        if (result is CreateSessionDialogResult dialogResult)
        {
            var config = dialogResult.Config;
            var enumResult = dialogResult.UseSameEngine && !string.IsNullOrEmpty(dialogResult.TargetEnginePodName)
                ? await EnumerationService.StartEnumerationOnEngineAsync(dialogResult.TargetEnginePodName, config)
                : await EnumerationService.StartEnumerationAsync(config);

            if (enumResult.Success)
            {
                NotificationService.Notify(NotificationSeverity.Success, "Enumeration started",
                    $"Session {enumResult.SessionToken} on {enumResult.EnginePodName}");
            }
            else
            {
                var errorMessage = enumResult.ErrorMessage ?? "Unknown error";
                NotificationService.Notify(NotificationSeverity.Error, "Enumeration failed", errorMessage);
                var configJson = JsonSerializer.Serialize(config);
                await SessionRepository.CreateFailedAsync(config.Scope?.Domains ?? [], configJson, errorMessage);
            }
        }
    }

    public void Dispose()
    {
        StateStore.OnStateChanged -= HandleStateChanged;
    }
}
