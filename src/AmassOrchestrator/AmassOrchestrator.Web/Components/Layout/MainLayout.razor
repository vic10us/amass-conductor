@inherits LayoutComponentBase
@inject AmassOrchestrator.Web.Services.ThemeService ThemeService
@inject IServiceProvider ServiceProvider

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-px-4" Style="width: 100%;">
            <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Amass Conductor</RadzenText>
            <div style="flex: 1;"></div>
            <RadzenButton Icon="@(ThemeService.IsDark ? "light_mode" : "dark_mode")"
                          ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Text"
                          Click="@ToggleTheme"
                          Size="ButtonSize.Medium" />
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="@_sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="" />
            <RadzenPanelMenuItem Text="Sessions" Icon="list" Path="sessions" />
            <RadzenPanelMenuItem Text="Logs" Icon="terminal" Path="logs" />
            <RadzenPanelMenuItem Text="Statistics" Icon="bar_chart" Path="statistics" />
            @if (ServiceProvider.GetService<IAmassDataService>() is not null)
            {
                <RadzenPanelMenuItem Text="Assets" Icon="storage">
                    <RadzenPanelMenuItem Text="Overview" Icon="dashboard" Path="assets" />
                    <RadzenPanelMenuItem Text="FQDNs" Icon="dns" Path="assets/fqdns" />
                    <RadzenPanelMenuItem Text="IP Addresses" Icon="lan" Path="assets/ips" />
                    <RadzenPanelMenuItem Text="Netblocks" Icon="hub" Path="assets/netblocks" />
                    <RadzenPanelMenuItem Text="ASNs" Icon="account_tree" Path="assets/asns" />
                    <RadzenPanelMenuItem Text="Certificates" Icon="verified_user" Path="assets/certificates" />
                    <RadzenPanelMenuItem Text="Domains" Icon="public" Path="assets/domains" />
                    <RadzenPanelMenuItem Text="Services" Icon="miscellaneous_services" Path="assets/services" />
                </RadzenPanelMenuItem>
            }
            <RadzenPanelMenuItem Text="Settings" Icon="settings" Path="settings" />
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<RadzenDialog />
<RadzenNotification />

@code {
    private bool _sidebarExpanded = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleAsync();
    }
}
