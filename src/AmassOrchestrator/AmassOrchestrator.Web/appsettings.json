{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "Namespace": "amass",
    "StatefulSetName": "amass-engine",
    "EnginePort": 4000,
    "PollIntervalSeconds": 10,
    "LabelSelector": "app.kubernetes.io/name=amass,app.kubernetes.io/component=engine",
    "EngineBasePath": "/api/v1"
  }
}
