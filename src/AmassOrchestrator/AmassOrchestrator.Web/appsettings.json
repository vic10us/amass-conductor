{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "path": "logs/orchestrator-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "Namespace": "amass",
    "StatefulSetName": "amass-engine",
    "EnginePort": 4000,
    "PollIntervalSeconds": 10,
    "LabelSelector": "app.kubernetes.io/name=amass,app.kubernetes.io/component=engine",
    "EngineBasePath": "/api/v1",
    "HttpClientTimeoutSeconds": 10,
    "WebSocketBufferSize": 4096,
    "CompletionPollThreshold": 5,
    "SupportedDatabaseSystems": ["postgres", "mysql"],
    "BruteForceWordlistFile": "wordlists/default-namelist.txt",
    "AlterationsWordlistFile": "wordlists/default-alterations.txt",
    "DefaultTransformationsFile": "wordlists/default-transformations.json",
    "AmassDbConnectionString": ""
  }
}
